dist/
build/
*.tsbuildinfo
next-env.d.ts

# IDE
.vscode/
.idea/

# Blender backups
*.blend1
*.blend2

# Runtime data
#
# Anchored to the repository root on purpose: these names are root-level runtime
# directories, and an unanchored pattern would also swallow legitimate source
# packages such as services/api/studio_api/storage.
/runtime/
/data/
/storage/
/renders/
/previews/
/logs/

# OS
.DS_Store
Thumbs.db

# Generated Blender test fixtures.
# The generator script and seed_project.spec.json are the committed source of
# truth; regenerate with:  python3 -m studio_fixtures.regenerate
tests/fixtures/blender/build/
