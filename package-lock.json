{
  "name": "ai-3d-design-studio",
  "version": "0.0.1",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "ai-3d-design-studio",
      "version": "0.0.1",
      "workspaces": [
        "packages/*",
        "apps/*"
      ],
      "engines": {
        "node": ">=22"
      }
    },
    "node_modules/@studio/contracts": {
      "resolved": "packages/contracts",
      "link": true
    },
    "node_modules/@studio/spatial": {
      "resolved": "packages/spatial",
      "link": true
    },
    "node_modules/@studio/types": {
      "resolved": "packages/types",
      "link": true
    },
    "node_modules/@studio/validation": {
      "resolved": "packages/validation",
      "link": true
    },
    "packages/contracts": {
      "name": "@studio/contracts",
      "version": "0.0.1",
      "dependencies": {
        "@studio/types": "*"
      }
    },
    "packages/spatial": {
      "name": "@studio/spatial",
      "version": "0.0.1",
      "dependencies": {
        "@studio/contracts": "*",
        "@studio/types": "*",
        "@studio/validation": "*"
      }
    },
    "packages/types": {
      "name": "@studio/types",
      "version": "0.0.1"
    },
    "packages/validation": {
      "name": "@studio/validation",
      "version": "0.0.1",
      "dependencies": {
        "@studio/contracts": "*",
        "@studio/types": "*"
      }
    }
  }
}
