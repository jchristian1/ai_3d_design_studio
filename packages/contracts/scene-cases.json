{
  "description": "Shared, language-neutral vectors for the AUTHORITATIVE scene-version digest (studio-scene-v1). Both languages compute canonical_json and scene_version for every scene below; tests/contracts/test_scene_digest_cross_language_parity.py asserts the two implementations produce byte-identical canonical JSON and identical hex digests. Cases are grouped by the property they pin: numeric formatting, ordering, exclusion, and sensitivity.",
  "numbers": {
    "description": "Fixed-decimal quantisation, round-half-to-even, negative-zero normalisation. Expected strings are asserted directly so a formatting change cannot pass silently in either language.",
    "cases": [
      { "name": "zero", "value": 0, "expected": "0.000000" },
      { "name": "negative zero", "value": -0.0, "expected": "0.000000" },
      { "name": "half meter", "value": 0.5, "expected": "0.500000" },
      { "name": "one", "value": 1, "expected": "1.000000" },
      { "name": "two meters", "value": 2.0, "expected": "2.000000" },
      { "name": "eighty percent of two", "value": 1.6, "expected": "1.600000" },
      { "name": "negative", "value": -0.25, "expected": "-0.250000" },
      { "name": "quarter pi radians", "value": 0.7853981633974483, "expected": "0.785398" },
      { "name": "half pi radians", "value": 1.5707963267948966, "expected": "1.570796" },
      { "name": "below the quantum vanishes", "value": 1e-9, "expected": "0.000000" },
      { "name": "tiny negative normalises to positive zero", "value": -1e-9, "expected": "0.000000" },
      { "name": "large coordinate", "value": 1234.567891, "expected": "1234.567891" },
      { "name": "colour channel", "value": 0.8000000119, "expected": "0.800000" }
    ],
    "rejected": [
      { "name": "not a number", "value": "0.5" },
      { "name": "null", "value": null },
      { "name": "boolean", "value": true }
    ]
  },
